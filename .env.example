VITE_GOOGLE_CLIENT_ID=tu-client-id-de-google.apps.googleusercontent.com
VITE_ADMIN_EMAILS=maestro@ejemplo.com,admin@ejemplo.com

# Configuración de Supabase (Base de datos relacional PostgreSQL)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Configuración de PostgreSQL local para scripts de prueba y migración
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulselab

# Configuración de Firebase (temporal durante migración)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
